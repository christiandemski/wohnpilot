# Copy to .env (never commit .env). Development: repository root.
# Deployment: next to composer.json in the backend folder.

# dev enables DEV_LOGIN_USER and detailed errors; anything else is production
APP_ENV=prod
# Public URL of the app, without trailing slash (BearID redirects to APP_URL/api/auth/callback)
APP_URL=

# Storage: nextcloud (default) or filesystem (local development)
STORAGE=nextcloud
# Only for STORAGE=filesystem; relative to backend/ (fill with: composer seed-dev)
FILESYSTEM_ROOT=var/notes

# Nextcloud (own app password just for Wohnpilot, revocable in Nextcloud)
NEXTCLOUD_URL=https://cloud.codekorb.de
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_FOLDER=Wohnpilot

# SQLite index (only a cache, rebuildable with: php bin/reindex.php --full)
INDEX_FILE=var/index.sqlite
# Seconds before the index checks Nextcloud for changes again
SYNC_MAX_AGE=30

# BearID (cookie sign-on for *.codekorb.de, like bearid-guard/guard.php)
BEARID_ISSUER=https://id.codekorb.de
# Path to bearid-guard/public.key on the webspace (absolute or relative to backend/); empty = BearID off
BEARID_PUBLIC_KEY_FILE=
# Kürzel of the tool in BearID (Admin → Tools), first part of the subdomain
BEARID_APP=wohnpilot

# E-mail accounts as fallback login (php bin/account.php add …); not a cache, back it up
ACCOUNTS_FILE=var/accounts.sqlite

# Usernames or e-mail addresses that may set up the household before it exists (comma separated)
WOHNPILOT_USERS=
# Only with APP_ENV=dev: sign in as this user without BearID
DEV_LOGIN_USER=

# Personal settings: calendar links, from step 8 also push subscriptions.
# Not a cache – back it up like ACCOUNTS_FILE
SETTINGS_FILE=var/settings.sqlite

# Web Push (VAPID): create the keys once with `php bin/vapid.php`; empty = push off.
# The morning summary comes from a cron job: php bin/notify.php (daily at 08:00)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services: mailto:you@example.org or the APP_URL (default)
VAPID_SUBJECT=
